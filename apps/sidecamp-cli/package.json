{
  "name": "sidecamp-cli",
  "private": true,
  "version": "0.1.0",
  "description": "Headless CLI for TuneCamp — search, download, upload without Electron.",
  "type": "module",
  "bin": {
    "sidecamp": "./bin/sidecamp.js"
  },
  "scripts": {
    "cli": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage:scriptc": "scriptc coverage src/index.ts --dynamic"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "andrade-soulseek-downloader": "^1.0.28",
    "commander": "^12.1.0",
    "fs-extra": "^11.3.6",
    "webtorrent": "^3.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
